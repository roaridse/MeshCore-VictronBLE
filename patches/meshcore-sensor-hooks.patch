+bool SensorMesh::sendChannelMessage(const mesh::GroupChannel& channel, const char* text) {
+  if (text == NULL || text[0] == 0) return false;
+  constexpr int max_text_len = 160;
+  uint8_t data[5 + max_text_len];
+  uint32_t timestamp = getRTCClock()->getCurrentTimeUnique();
+  memcpy(data, &timestamp, 4);
+  data[4] = 0;  // TXT_TYPE_PLAIN
+
+  const char* name = _prefs.node_name;
+  int prefix_len = snprintf((char*)&data[5], max_text_len, "%s: ", name);
+  if (prefix_len < 0 || prefix_len >= max_text_len) return false;
+  int text_len = strlen(text);
+  if (text_len > max_text_len - prefix_len) text_len = max_text_len - prefix_len;
+  memcpy(&data[5 + prefix_len], text, text_len);
+
+  mesh::Packet* packet = createGroupDatagram(PAYLOAD_TYPE_GRP_TXT, channel, data,
+                                             5 + prefix_len + text_len);
+  if (packet == NULL) return false;
+  sendFloodScoped(default_scope, packet, 0, _prefs.path_hash_mode + 1);
+  return true;
+}
